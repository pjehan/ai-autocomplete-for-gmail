{
  "manifest_version": 3,
  "name": "Chrome Extension Email Autocomplete",
  "version": "1.0",
  "description": "Autocomplete suggestions for email composition in Gmail",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*", "https://gmail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/*"],
      "matches": ["https://mail.google.com/*", "https://gmail.google.com/*"]
    }
  ]
}
